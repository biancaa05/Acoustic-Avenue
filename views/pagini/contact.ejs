                        </div>
                        <figcaption><strong>Shure</strong> <span>Microfoane Studio</span></figcaption>
                    </figure>

                    <figure class="card-partener">
                        <div class="wrapper-img">
                            <img src="/resurse/imagini/parteneri/zildjian.png" alt="Zildjian">
                        </div>
                        <figcaption><strong>Zildjian</strong> <span>Cinele Premium</span></figcaption>
                    </figure>

                    <figure class="card-partener">
                        <div class="wrapper-img">
                            <img src="/resurse/imagini/parteneri/steinway.png" alt="Steinway">
                        </div>
                        <figcaption><strong>Steinway</strong> <span>Piane de Concert</span></figcaption>
                    </figure>

                    <figure class="card-partener">
                        <div class="wrapper-img">
