<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Contact și Parteneri - Acoustic Avenue</title>
    <meta name="description" content="Contact si parteneri pentru magazinul Acoustic Avenue">
    <meta name="keywords" content="contact, locatie showroom Acoustic Avenue, magazin fmi, parteneri Acoustic Avenue">
    <%- include('../fragmente/head.ejs') %>
</head>
<body>
    <%- include('../fragmente/header.ejs') %>
    <main class="pagina-contact-animata">
        <div id="gridul-pagina">
            <section id="zona1">
                <hgroup id="welcome">
                    <h2>Contact Acoustic Avenue</h2>
                    <p class="subtitlu">Suntem aici să îți acordăm pasiunea</p>
                </hgroup>
                
                <div class="showroom-wrapper">
                    <section id="detalii-contact">
                        <h3>Informații Sediu</h3>
                        <address>
                            <strong>Acoustic Avenue HQ</strong><br> 
                            <i class="fa-solid fa-phone"></i> Telefon: <a href="tel:+40771146577">+40 771 146 577</a><br>
                            <i class="fa-solid fa-envelope"></i> Email: <a href="mailto:office@acousticavenue.ro">office@acousticavenue.ro</a><br>
                            <i class="fa-solid fa-location-dot"></i> Adresa: Strada Academiei, Nr. 14, București (FMI)
                        </address>
                        <br>
                        <p class="atentie-box">
                            <strong>REZERVARE:</strong> Testarea instrumentelor în showroom se face doar pe bază de programare telefonică pentru a asigura disponibilitatea cabinelor izolate fonic.
                        </p>
                    </section>
                    
                    <div id="dv-prezentare">
                        <i class="fa-solid fa-envelope-open-text pin-locatie"></i>
                        <img src="/resurse/imagini/showroom_main.jpg" alt="Contact Acoustic Avenue" />
                    </div>
                </div>
            </section>

            <section id="sectiune-orar-tabel" class="container">
    <div class="tabel-responsive-wrapper">
        <table id="tab-orar">
            <caption>Program & Consultanță Acoustic Avenue - 2026</caption>
            <thead>
                <tr>
                    <th>Ziua</th>
                    <th>Deschidere</th>
                    <th>Închidere</th>
                    <th>Departament</th>
                    <th>Disponibilitate</th>
                    <th>Observații</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td data-label="Ziua">Luni - Miercuri</td>
                    <td data-label="Deschidere">09:00</td>
                    <td data-label="Închidere">20:00</td>
                    <td data-label="Departament">Vânzări & Showroom</td>
                    <td data-label="Disponibilitate">Ridicat</td>
                    <td data-label="Observații">Programări prioritare</td>
                </tr>
                <tr>
                    <td data-label="Ziua">Joi</td>
                    <td data-label="Deschidere">09:00</td>
                    <td data-label="Închidere">20:00</td>
                    <td data-label="Departament">Vânzări & Logistică</td>
                    <td data-label="Disponibilitate">Mediu</td>
                    <td data-label="Observații">Zile de recepție marfă</td>
                </tr>
                <tr>
                    <td data-label="Ziua">Vineri</td>
                    <td data-label="Deschidere">09:00</td>
                    <td data-label="Închidere">18:00</td>
                    <td data-label="Departament">Service & Showroom</td>
                    <td data-label="Disponibilitate">Ridicat</td>
                    <td data-label="Observații">Închidere timpurie</td>
                </tr>
                <tr>
                    <td data-label="Ziua">Sâmbătă</td>
                    <td data-label="Deschidere">10:00</td>
                    <td data-label="Închidere">16:00</td>
                    <td data-label="Departament">Showroom</td>
                    <td data-label="Disponibilitate">Scăzut</td>
                    <td data-label="Observații">Flux mare de vizitatori</td>
                </tr>
                <tr>
                    <td data-label="Ziua">Duminică</td>
                    <td data-label="Deschidere">Închis</td>
                    <td data-label="Închidere">Închis</td>
                    <td data-label="Departament">Suport Online</td>
                    <td data-label="Disponibilitate">N/A</td>
                    <td data-label="Observații">Doar comenzi web</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

