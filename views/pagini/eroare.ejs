<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titlu %></title>
    <%- include('../fragmente/head.ejs') %>
</head>
<body>
    <%- include('../fragmente/header.ejs') %>
    
    <main style="text-align: center; padding: 60px 20px; min-height: 60vh;">
         <h2 style="color: var(--mahon);"><%= titlu %></h2>
         <p style="font-size: 1.2rem; margin-bottom: 20px;"><%= text %></p>
         
         <img src="<%= imagine %>" alt="<%= titlu %>" style="max-width: 400px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
         
         <br><br>
         <a href="/" style="color: var(--gold); font-weight: bold; font-size: 1.1rem;">Înapoi la pagina principală</a>
    </main>

    <%- include('../fragmente/footer.ejs') %>
</body>
</html>