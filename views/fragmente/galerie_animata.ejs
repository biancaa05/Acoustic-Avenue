<h2>Galerie Animată</h2>
<%
    const nrImagini = (Math.floor(Math.random() * 5) + 1) * 3;
    const maxOffset = Math.max(0, imagini.length - nrImagini);
    const offset = Math.floor(Math.random() * (maxOffset + 1));
    const imaginiSelectate = imagini.slice(offset, offset + nrImagini);
%>

<section id="galerie-animata" style="--nr-imag: <%- nrImagini %>;" class="d-none d-lg-block">
    <div class="galerie-container">
        <% imaginiSelectate.forEach((img) => { %>
            <figure class="gal-item">
                <img src="/resurse/imagini/galerie/<%- img.cale_relativa %>" alt="<%- img.alternativ %>">
                <figcaption><%- img.nume_imag %></figcaption>
            </figure>
        <% }) %>
    </div>
</section>